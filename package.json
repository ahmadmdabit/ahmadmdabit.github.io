{
  "name": "ahmet.fatihoglu.github.io-ide",
  "description": "Ahmet Fatihoglu's personal website",
  "author": "Ahmet Fatihoglu",
  "license": "SEE LICENSE IN LICENSE.txt",
  "homepage": "https://ahmadmdabit.github.io/",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "hash-locales": "node scripts/hash-locale.mjs",
    "dev": "vite",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "build": "tsc -b && yarn hash-locales && node scripts/update-sitemap.mjs && vite build && node scripts/prerender.mjs",
    "build:lint": "yarn lint:fix && yarn build",
    "preview": "vite preview",
    "predeploy": "yarn build:lint",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/cascadia-code": "^5.3.0",
    "@heyputer/puter.js": "^2.6.2",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "dompurify": "^3.4.14",
    "i18next": "^26.4.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.2",
    "marked": "^18.0.11",
    "minisearch": "^7.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-router": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^7.18.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "gh-pages": "^6.3.0",
    "globals": "^17.12.0",
    "promisify-child-process": "^5.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  }
}
